APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@think.com
MAIL_FROM_NAME=Think
# Desligue em local/dev para nao disparar e-mails reais (MailService retorna skipped).
MAIL_ENABLED=true
# URL do front Angular (links em e-mails de jobs/check-in/cedente).
APP_URL_FRONT=http://localhost:4200
# E-mail automatico quando status do cedente muda (requer cedente.email preenchido).
CEDENTE_STATUS_EMAIL_ENABLED=false
# Departamento/cargo padrao ao cadastrar usuario so do modulo cedente (obrigatorio no banco employee).
# Se vazio, usa departamento/cargo existente sem privilegios especiais do jobs.
# CEDENTE_EMPLOYEE_DEPARTMENT_ID=2
# CEDENTE_EMPLOYEE_POSITION_ID=1
CEDENTE_EMPLOYEE_PAYMENT=10
# 0 = nao aparece em pickers de agenda/tarefas do jobs
CEDENTE_EMPLOYEE_SCHEDULE_ACTIVE=0

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

# Raiz onde ficam project-files, briefing-files, cedente-files, etc. (absoluto, sem barra no final).
# Se vazio, o cadastro de cedente usa storage/app/files (fallback só em CedenteFile).
# FILES_FOLDER=/var/www/seu-projeto/storage/app/files
FILES_FOLDER=/files/

# Armazenamento de arquivos de cedente: local (FILES_FOLDER) ou s3.
# Novos uploads usam este disco; registros antigos permanecem local ate migracao.
CEDENTE_FILES_DISK=local
# Credenciais S3 (aceita AWS_* ou S3_* legado do GoalController).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Prefixo opcional dentro do bucket (ex.: think-prod).
AWS_PREFIX=

# Verificacao SSL nas chamadas SERPRO (true/false). Em local/WSL, use false se aparecer cURL error 60.
SERPRO_SSL_VERIFY=false
# Liga a validacao SERPRO no fluxo pendente (independente da Vadu).
SERPRO_ENABLED=true

# Consulta CNPJ QSA (producao).
SERPRO_QSA_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cnpj-df/v2/qsa/
SERPRO_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token

# OAuth: Consumer Key / Consumer Secret. A app gera o Bearer via POST /token.
# Se o POST /token falhar (SSL, etc.), usa SERPRO_BEARER_TOKEN como fallback (como nos testes em producao).
SERPRO_USERNAME=
SERPRO_PASSWORD=
SERPRO_BEARER_TOKEN=

# Daycoval / Portal Servicos (SOAP cadastroCedenteAprovado).
# BASE_URL sem barra final, ex: https://host/portal-servicos
DAYCOVAL_ENABLED=false
DAYCOVAL_BASE_URL=
DAYCOVAL_USERNAME=
DAYCOVAL_PASSWORD=
DAYCOVAL_SSL_VERIFY=false
DAYCOVAL_TIMEOUT=60
# Se true, falha na Daycoval sobe excecao no envio (a aprovacao local ja foi gravada).
DAYCOVAL_FAIL_ON_ERROR=false
DAYCOVAL_DEFAULT_PORTE=9
DAYCOVAL_DEFAULT_RAMO=SERVICOS
DAYCOVAL_DEFAULT_TIPO_SOCIEDADE=LTDA
DAYCOVAL_DEFAULT_CLASS_RISCO=1

# Vadu/CreditBox — restricoes (com restricao: status cancelado + trava permanente).
# Roda antes da SERPRO, com VADU_ENABLED independente de SERPRO_ENABLED.
# Fluxo: VADU_TOKEN (master) -> GET JSONPegarToken -> token temporario -> POST Consulta/{cnpj}
VADU_ENABLED=true
VADU_TOKEN=
VADU_TOKEN_URL=https://www.creditbox.com.br/CreditBox.dll/Autenticacao/JSONPegarToken
VADU_CONSULTA_URL=https://www.vadu.com.br/vadu.dll/ServicoAnaliseOperacao/Consulta
VADU_TOKEN_TTL_MINUTES=50
VADU_SSL_VERIFY=false
VADU_TIMEOUT=60